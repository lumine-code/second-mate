{
  "name": "@lumine-code/second-mate",
  "author": "lumine-code",
  "version": "9.0.0",
  "description": "Provides TextMate grammar, tokenization, and scope-selection helpers.",
  "keywords": [
    "textmate",
    "grammar",
    "tokenizer",
    "syntax-highlighting",
    "scope",
    "oniguruma",
    "lumine"
  ],
  "main": "./lib/second-mate.js",
  "scripts": {
    "test": "jasmine",
    "benchmark": "node benchmark/benchmark.js",
    "parse": "peggy -o ./lib/scope-selector-parser.js ./src/scope-selector-parser.pegjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": "https://github.com/lumine-code/second-mate",
  "bugs": "https://github.com/lumine-code/second-mate/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lumine-code/second-mate",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lumine-code/event-kit": "github:lumine-code/event-kit#161f2c92f860f4e4553848e61fd3d776b2512d1a",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#a5911f08dc9a762b3f2e9a0dc5fca9cfea7aada6",
    "@lumine-code/season": "github:lumine-code/season#6a7336d4be7ed778bebde141193317f82bf4c862",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#9b0c8a6bc845c5ecd594d673ab97f4ddbe9e546f",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "jasmine": "^6.3.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6"
  }
}
