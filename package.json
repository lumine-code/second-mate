{
  "name": "@lumine-code/second-mate",
  "author": "lumine-code",
  "version": "9.0.0",
  "description": "Provides TextMate grammar, tokenization, and scope-selection helpers.",
  "keywords": [
    "textmate",
    "grammar",
    "tokenizer",
    "syntax-highlighting",
    "scope",
    "oniguruma",
    "lumine"
  ],
  "main": "./lib/second-mate.js",
  "scripts": {
    "test": "jasmine",
    "benchmark": "node benchmark/benchmark.js",
    "parse": "peggy -o ./lib/scope-selector-parser.js ./src/scope-selector-parser.pegjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": "https://github.com/lumine-code/second-mate",
  "bugs": "https://github.com/lumine-code/second-mate/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lumine-code/second-mate",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lumine-code/event-kit": "github:lumine-code/event-kit#e58590f906728e92a9e13504fe2a55b0514926be",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#d864d8178848421b65132e5992398c84ec4e64df",
    "@lumine-code/season": "github:lumine-code/season#c60be7c9fd1371177d942161daf86243c39bc680",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#fd9c48ac852a303e1fbc2e1ae77dbefa57ba6052",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "jasmine": "^7.0.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6"
  }
}
