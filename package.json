{
  "name": "@lumine-code/second-mate",
  "author": "lumine-code",
  "version": "9.0.0",
  "description": "Provides TextMate grammar, tokenization, and scope-selection helpers.",
  "keywords": [
    "textmate",
    "grammar",
    "tokenizer",
    "syntax-highlighting",
    "scope",
    "oniguruma",
    "lumine"
  ],
  "main": "./lib/second-mate.js",
  "scripts": {
    "test": "jasmine",
    "benchmark": "node benchmark/benchmark.js",
    "parse": "peggy -o ./lib/scope-selector-parser.js ./src/scope-selector-parser.pegjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": "https://github.com/lumine-code/second-mate",
  "bugs": "https://github.com/lumine-code/second-mate/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lumine-code/second-mate",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lumine-code/event-kit": "github:lumine-code/event-kit#3205d19fd0ca20077def9214d3475f26d502cc09",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#ba2792e2fd5637748cdc9317886e6d3cac2ce801",
    "@lumine-code/season": "github:lumine-code/season#4eaaac38bdb8c01a876b72a52233eb5686728903",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#cbf9388917fd1d59a533f43cf68a80d0c48036ac",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "jasmine": "^6.3.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6"
  }
}
