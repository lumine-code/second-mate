{
  "name": "@lumine-code/second-mate",
  "author": "lumine-code",
  "version": "9.0.0",
  "description": "Provides TextMate grammar, tokenization, and scope-selection helpers.",
  "keywords": [
    "textmate",
    "grammar",
    "tokenizer",
    "syntax-highlighting",
    "scope",
    "oniguruma",
    "lumine"
  ],
  "main": "./lib/second-mate.js",
  "scripts": {
    "test": "jasmine",
    "benchmark": "node benchmark/benchmark.js",
    "parse": "peggy -o ./lib/scope-selector-parser.js ./src/scope-selector-parser.pegjs",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "repository": "https://github.com/lumine-code/second-mate",
  "bugs": "https://github.com/lumine-code/second-mate/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lumine-code/second-mate",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@lumine-code/event-kit": "github:lumine-code/event-kit#1f8b5baa31fd955b6c1689905f348888b6474b1f",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#8058c4ee899012b1bc6fa92d74d61220659d2da9",
    "@lumine-code/season": "github:lumine-code/season#e46f11c96163e4183a2747d4fd81e0b02f6b9682",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#9b0c8a6bc845c5ecd594d673ab97f4ddbe9e546f",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "jasmine": "^6.3.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6"
  }
}
